<grit-part>
  <message name="IDS_CLOSE_TABS_ON_EXIT_TITLE" desc="Title of closing tabs on exit menu item">
    Close tabs on exit
  </message>
  <message name="IDS_CLOSE_TABS_ON_EXIT_SUMMARY" desc="Summary of closing tabs on exit menu item">
    Don't persist tabs between browsing sessions
  </message>
  <!-- Referrer toggle -->
  <message name="IDS_CROSS_ORIGIN_REFERRER_POLICY_TITLE" desc="Cross-origin referrer policy setting label">
    Cross-origin referrer policy
  </message>
  <message name="IDS_CROSS_ORIGIN_REFERRER_POLICY_DEFAULT" desc="Select value">
    Default
  </message>
  <message name="IDS_CROSS_ORIGIN_REFERRER_POLICY_REDUCE" desc="Select value">
    Reduce cross-origin referrer
  </message>
  <message name="IDS_CROSS_ORIGIN_REFERRER_POLICY_DISABLE" desc="Select value">
    Disable cross-origin referrer
  </message>
  <message name="IDS_OPEN_LINKS_IN_INCOGNITO_TITLE" desc="Title of opening external links in incognito tabs menu item">
    Open external links in incognito
  </message>
  <message name="IDS_OPEN_LINKS_IN_INCOGNITO_SUMMARY" desc="Summary of opening external links in incognito tabs menu item">
    Open links navigated by external apps in incognito tabs
  </message>
  <!-- WebRTC toggle -->
  <message name="IDS_WEBRTC_POLICY_TITLE" desc="WebRTC policy setting label">
    WebRTC IP handling policy
  </message>
  <message name="IDS_WEBRTC_POLICY_DEFAULT" desc="Select value">
    Default
  </message>
  <message name="IDS_WEBRTC_POLICY_DEFAULT_PUBLIC_AND_PRIVATE_INTERFACES" desc="Select value">
    Default public and private interfaces
  </message>
  <message name="IDS_WEBRTC_POLICY_DEFAULT_PUBLIC_INTERFACE_ONLY" desc="Select value">
    Default public interface only
  </message>
  <message name="IDS_WEBRTC_POLICY_DISABLE_NON_PROXIED_UDP" desc="Select value">
    Disable non-proxied UDP
  </message>
</grit-part>
